import { useTranslation } from "react-i18next";
import { Box, Button, IconButton, TextField, Stack, Typography } from "@mui/material";
import Autocomplete from "@mui/material/Autocomplete";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";
import ArrowUpward from "@mui/icons-material/ArrowUpward";
import ArrowDownward from "@mui/icons-material/ArrowDownward";

type NotificationItem = { id: string; notificationName?: string; type?: string; address?: string };

export type EscalationRule = { notificationId: string; delayMinutes: number };

interface Props {
  value?: EscalationRule[];
  onChange?: (rules: EscalationRule[]) => void;
  disabled?: boolean;
}

export default function EscalationRulesEditor({ value = [], onChange, disabled = false }: Props) {
  const { t } = useTranslation();
  const [notifications, setNotifications] = useState<NotificationItem[]>([]);
  const [rules, setRules] = useState<EscalationRule[]>(value);

  useEffect(() => {
    // load team notifications
    let mounted = true;
    fetch("/api/v1/notifications", { credentials: "same-origin" })
      .then((r) => r.json())
      .then((json) => {
        if (!mounted) return;
        setNotifications(Array.isArray(json?.data) ? json.data : []);
      })
      .catch(() => {
        setNotifications([]);
      });
    return () => {
      mounted = false;
    };
  }, []);

  useEffect(() => {
    setRules(value);
  }, [value]);

  const updateRules = (next: EscalationRule[]) => {
    setRules(next);
    onChange?.(next);
  };

  const addRule = () => updateRules([...rules, { notificationId: "", delayMinutes: 0 }]);

  const removeRule = (index: number) => updateRules(rules.filter((_, i) => i !== index));

  const move = (index: number, dir: -1 | 1) => {
    const newIndex = index + dir;
    if (newIndex < 0 || newIndex >= rules.length) return;
    const copy = [...rules];
    const [item] = copy.splice(index, 1);
    copy.splice(newIndex, 0, item);
    updateRules(copy);
  };

  return (
    <Box>
      <Stack direction="row" alignItems="center" justifyContent="space-between" mb={1}>
        <Box>
          <Typography variant="h6">{t("escalation.header", "Escalation Rules")}</Typography>
          <Typography variant="body2" color="textSecondary">
            {t(
              "escalation.sub",
              "If the monitor stays down for the specified time, notify additional channels."
            )}
          </Typography>
        </Box>
        <Button startIcon={<AddIcon />} onClick={addRule} disabled={disabled}>
          {t("escalation.addRule", "Add rule")}
        </Button>
      </Stack>

      {rules.length === 0 && (
        <Typography variant="body2" color="textSecondary" mb={2}>
          {t("escalation.noRules", "No escalation rules configured")}
        </Typography>
      )}

      <Stack spacing={2}>
        {rules.map((rule, idx) => (
          <Stack key={idx} direction={{ xs: "column", sm: "row" }} spacing={1} alignItems="center">
            <Autocomplete
              sx={{ flex: 1, minWidth: 240 }}
              options={notifications}
              getOptionLabel={(opt) => opt.notificationName || `${opt.type || ""} ${opt.address || ""}`}
              value={notifications.find((n) => n.id === rule.notificationId) ?? null}
              onChange={(_, selected) => {
                updateRules(rules.map((r, i) => (i === idx ? { ...r, notificationId: selected?.id ?? "" } : r)));
              }}
              renderInput={(params) => (
                <TextField
                  {...params}
                  label={t("escalation.selectNotification", "Escalation Notification channels")}
                  placeholder={t("escalation.typeToSearch", "Type to search")}
                  size="small"
                  disabled={disabled}
                />
              )}
              freeSolo={false}
              clearOnEscape
            />

            <TextField
              sx={{ width: 160 }}
              label={t("escalation.delayLabel", "Escalate after (minutes)")}
              type="number"
              inputProps={{ min: 0 }}
              size="small"
              value={rule.delayMinutes}
              onChange={(e) =>
                updateRules(rules.map((r, i) => (i === idx ? { ...r, delayMinutes: Number(e.target.value || 0) } : r)))
              }
              disabled={disabled}
            />

            <Stack direction="row" spacing={0.5}>
              <IconButton size="small" onClick={() => move(idx, -1)} disabled={idx === 0 || disabled}>
                <ArrowUpward fontSize="small" />
              </IconButton>
              <IconButton size="small" onClick={() => move(idx, 1)} disabled={idx === rules.length - 1 || disabled}>
                <ArrowDownward fontSize="small" />
              </IconButton>
              <IconButton size="small" color="error" onClick={() => removeRule(idx)} disabled={disabled}>
                <DeleteIcon fontSize="small" />
              </IconButton>
            </Stack>
          </Stack>
        ))}
      </Stack>
    </Box>
  );
