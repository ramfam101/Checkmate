import React from "react";
import { useTranslation } from "react-i18next";
import { Box, Button, IconButton, TextField, Stack, Typography } from "@mui/material";
import Autocomplete from "@mui/material/Autocomplete";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";
import ArrowUpwardIcon from "@mui/icons-material/ArrowUpward";
import ArrowDownwardIcon from "@mui/icons-material/ArrowDownward";
import type { Notification } from "@/Types/Notification";

export type EscalationRule = { notificationId: string; delayMinutes: number };

interface Props {
  value?: EscalationRule[];
  onChange?: (rules: EscalationRule[]) => void;
  notifications?: Notification[] | null;
  disabled?: boolean;
}

export default function EscalationRulesEditor({ value = [], onChange, notifications = [], disabled = false }: Props) {
  const { t } = useTranslation();
  const rules = Array.isArray(value) ? value : [];

  const notificationOptions = (notifications ?? []).map((n) => ({ id: n.id, label: n.notificationName ?? n.id }));

  const update = (next: EscalationRule[]) => onChange?.(next);

  const addRule = () => update([...rules, { notificationId: "", delayMinutes: 0 }]);

  const removeRule = (index: number) => update(rules.filter((_, i) => i !== index));

  const move = (index: number, dir: -1 | 1) => {
    const to = index + dir;
    if (to < 0 || to >= rules.length) return;
    const copy = [...rules];
    const [item] = copy.splice(index, 1);
    copy.splice(to, 0, item);
    update(copy);
  };

  const setNotification = (index: number, notificationId: string) =>
    update(rules.map((r, i) => (i === index ? { ...r, notificationId } : r)));

  const setDelay = (index: number, delayMinutes: number) =>
    update(rules.map((r, i) => (i === index ? { ...r, delayMinutes } : r)));

  return (
    <Box>
      <Stack direction="row" alignItems="center" justifyContent="space-between" mb={1}>
        <Box>
          <Typography variant="h6">{t("escalation.header", "Escalation Rules")}</Typography>
          <Typography variant="body2" color="textSecondary">
            {t(
              "escalation.sub",
              "If the monitor stays down for the specified time, notify additional channels."
            )}
          </Typography>
        </Box>
        <Button startIcon={<AddIcon />} onClick={addRule} disabled={disabled}>
          {t("escalation.addRule", "Add rule")}
        </Button>
      </Stack>

      {rules.length === 0 && (
        <Typography variant="body2" color="textSecondary" mb={2}>
          {t("escalation.noRules", "No escalation rules configured")}
        </Typography>
      )}

      <Stack spacing={2}>
        {rules.map((rule, idx) => (
          <Stack key={idx} direction={{ xs: "column", sm: "row" }} spacing={1} alignItems="center">
            <Autocomplete
              sx={{ flex: 1, minWidth: 240 }}
              options={notificationOptions}
              getOptionLabel={(opt) => opt.label}
              value={notificationOptions.find((n) => n.id === rule.notificationId) ?? null}
              onChange={(_, selected) => setNotification(idx, selected?.id ?? "")}
              renderInput={(params) => (
                <TextField
                  {...params}
                  label={t("escalation.selectNotification", "Escalation Notification channels")}
                  placeholder={t("escalation.typeToSearch", "Type to search")}
                  size="small"
                />
              )}
              isOptionEqualToValue={(option, value) => option.id === value.id}
              disabled={disabled || notificationOptions.length === 0}
            />

            <TextField
              sx={{ width: 160 }}
              label={t("escalation.delayLabel", "Escalate after (minutes)")}
              type="number"
              inputProps={{ min: 0 }}
              size="small"
              value={String(rule.delayMinutes ?? 0)}
              onChange={(e) => {
                const v = Number(e.target.value || 0);
                setDelay(idx, Number.isNaN(v) ? 0 : v);
              }}
              disabled={disabled}
            />

            <Stack direction="row" spacing={0.5}>
              <IconButton size="small" onClick={() => move(idx, -1)} disabled={idx === 0 || disabled}>
                <ArrowUpwardIcon fontSize="small" />
              </IconButton>
              <IconButton size="small" onClick={() => move(idx, 1)} disabled={idx === rules.length - 1 || disabled}>
                <ArrowDownwardIcon fontSize="small" />
              </IconButton>
              <IconButton size="small" color="error" onClick={() => removeRule(idx)} disabled={disabled}>
                <DeleteIcon fontSize="small" />
              </IconButton>
            </Stack>
          </Stack>
        ))}
      </Stack>
    </Box>
  );
