				teamId,
				monitorIds,
				notificationIds,
				action,
			});

			return res.status(200).json({
				success: true,
				msg: `Notifications updated successfully on ${modifiedCount} monitor(s)`,
				data: { modifiedCount },
			});
		} catch (error) {
			next(error);
		}
	};
