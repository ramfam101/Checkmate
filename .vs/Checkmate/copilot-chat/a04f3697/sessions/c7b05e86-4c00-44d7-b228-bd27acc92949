          {t("escalation.addRule", "Add rule")}
        </Button>
      </Stack>

      {rules.length === 0 && (
        <Typography variant="body2" color="textSecondary" mb={2}>
          {t("escalation.noRules", "No escalation rules configured")}
        </Typography>
      )}

      <Stack spacing={2}>
        {rules.map((rule, idx) => (
          <Stack key={idx} direction={{ xs: "column", sm: "row" }} spacing={1} alignItems="center">
            <Autocomplete
              sx={{ flex: 1, minWidth: 240 }}
              options={notificationOptions}
              getOptionLabel={(opt) => opt.label}
              value={notificationOptions.find((n) => n.id === rule.notificationId) ?? null}
              onChange={(_, selected) => setNotification(idx, selected?.id ?? "")}
              renderInput={(params) => (
                <TextField
                  {...params}
                  label={t("escalation.selectNotification", "Escalation Notification channels")}
                  placeholder={t("escalation.typeToSearch", "Type to search")}
                  size="small"
                />
              )}
              isOptionEqualToValue={(option, value) => option.id === value.id}
              disabled={disabled || notificationOptions.length === 0}
            />

            <TextField
              sx={{ width: 160 }}
              label={t("escalation.delayLabel", "Escalate after (minutes)")}
              type="number"
              inputProps={{ min: 0 }}
              size="small"
              value={String(rule.delayMinutes ?? 0)}
              onChange={(e) => {
                const v = Number(e.target.value || 0);
                setDelay(idx, Number.isNaN(v) ? 0 : v);
              }}
              disabled={disabled}
            />

            <Stack direction="row" spacing={0.5}>
              <IconButton size="small" onClick={() => move(idx, -1)} disabled={idx === 0 || disabled}>
                <ArrowUp size={14} />
              </IconButton>
              <IconButton size="small" onClick={() => move(idx, 1)} disabled={idx === rules.length - 1 || disabled}>
                <ArrowDown size={14} />
              </IconButton>
              <IconButton size="small" color="error" onClick={() => removeRule(idx)} disabled={disabled}>
                <Trash2 size={14} />
              </IconButton>
            </Stack>
          </Stack>
        ))}
      </Stack>
    </Box>
  );
