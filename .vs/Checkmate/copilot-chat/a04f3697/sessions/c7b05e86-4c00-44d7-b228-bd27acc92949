		if (Array.isArray(payload.escalationRules) && payload.escalationRules.length > 0) {
			// Convert frontend shape { notificationId, delayMinutes } -> DB shape { notification, delayMinutes }
			payload.escalationRules = payload.escalationRules.map((r: any) => ({
				notification: r.notificationId ?? r.notification ?? "",
				delayMinutes: Number(r.delayMinutes ?? 0),
			}));
