						},
					},
					pausedMonitors: {
						$sum: {
							$cond: [{ $eq: ["$status", "paused"] }, 1, 0],
						},
					},
					initializingMonitors: {
						$sum: {
							$cond: [{ $eq: ["$status", "initializing"] }, 1, 0],
						},
