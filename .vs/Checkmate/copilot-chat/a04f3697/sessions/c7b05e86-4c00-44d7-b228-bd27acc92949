			group: doc.group ?? null,
			recentChecks: (doc.recentChecks ?? []).map((check: CheckSnapshotDocument) => this.toCheckSnapshot(check)),
			geoCheckEnabled: doc.geoCheckEnabled ?? false,
			geoCheckLocations: doc.geoCheckLocations ?? [],
