				{
					notification: String(payload.escalationNotificationId),
					delayMinutes: Number(payload.escalationDelayMinutes ?? 0),
				},
			];
		} else {
			// Ensure field is present (empty array) to clear existing rules when user removed them
			payload.escalationRules = [];
		}

