		return {
			id: doc.id,
			status: doc.status,
			responseTime: doc.responseTime,
			timings: doc.timings,
			statusCode: doc.statusCode,
			message: doc.message,
			cpu: doc.cpu,
			memory: doc.memory,
			disk: doc.disk,
			host: doc.host,
			errors: doc.errors,
			capture: doc.capture,
			net: doc.net,
			accessibility: doc.accessibility,
			bestPractices: doc.bestPractices,
			seo: doc.seo,
			performance: doc.performance,
			audits: doc.audits,
			createdAt: toDateString(doc.createdAt),
		};
